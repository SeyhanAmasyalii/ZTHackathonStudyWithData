# Bu dosyayı .env olarak kopyalayın ve değerleri Foundry'den ("Uç noktayı görüntüle") doldurun.
# .env repoya girmez.
AZURE_OPENAI_ENDPOINT=<PLACEHOLDER>
AZURE_OPENAI_API_KEY=<PLACEHOLDER>
CHAT_DEPLOYMENT=gpt-5.5
CORS_ORIGINS=["http://localhost:3000"]

# Demo: veri 2026-10-17 09:00'da biter; "şu an" sabitlenir (varsayılan bu). Gerçek saat için: DEMO_NOW=
DEMO_NOW=2026-10-17T09:15:00+03:00
# Giriş ekranı gelene kadar sohbeti yapan kullanıcı (kibana_logs.user_name)
DEMO_USER=elif
# Veri klasörü; boşsa repodaki datav2/
# DATA_DIR=../datav2
