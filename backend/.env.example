# Bu dosyayı .env olarak kopyalayın ve değerleri Foundry'den ("Uç noktayı görüntüle") doldurun.
# .env repoya girmez.
AZURE_OPENAI_ENDPOINT=<PLACEHOLDER>
AZURE_OPENAI_API_KEY=<PLACEHOLDER>
CHAT_DEPLOYMENT=gpt-5.5
CORS_ORIGINS=["http://localhost:3000"]

# Demo: veri 2026-10-17 09:00'da biter; "şu an" sabitlenir (varsayılan bu). Gerçek saat için: DEMO_NOW=
DEMO_NOW=2026-10-17T09:15:00+03:00
# Oturum token'larını imzalayan anahtar; boşsa her açılışta geçici anahtar üretilir.
# Azure'da App Settings'te uzun, rastgele bir değer verin. Repoya yazmayın.
# SESSION_SECRET=<PLACEHOLDER>
# Veri klasörü; boşsa repodaki datav2/
# DATA_DIR=../datav2

# Azure SQL (docs/AZURE-SQL.md). SQL_SERVER boşsa veri datav2 JSON'larından okunur.
# SQL_USER boşsa Microsoft Entra ile bağlanılır (yerelde önce `az login`).
# SQL_SERVER=<sunucu-adi>.database.windows.net
# SQL_DATABASE=mercekdb
# SQL_USER=<PLACEHOLDER>
# SQL_PASSWORD=<PLACEHOLDER>

# Azure AI Search (docs/AZURE-AI-SEARCH.md). SEARCH_ENDPOINT boşsa hata_ara aracı sunulmaz.
# SEARCH_API_KEY boşsa Microsoft Entra ile bağlanılır (Azure'da Managed Identity).
# SEARCH_ENDPOINT=https://<arama-hizmeti>.search.windows.net
# SEARCH_API_KEY=<PLACEHOLDER>
# SEARCH_LOG_INDEX=mercek-loglar
# Hazır çözüm indeksi kurulunca (build_search_index.py --indeks cozumler); boşsa benzer_cozum_ara sunulmaz.
# SEARCH_SOLUTION_INDEX=mercek-cozumler
# Yalnızca kurulum betiği (scripts/build_search_index.py) kullanır; App Service'te gerekmez.
# EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Hata ayıklama: modele giden/dönen her şeyi terminale yazar (kullanıcı mesajları dahil).
# Yalnızca yerelde kullanın.
LLM_DEBUG=false
